# Corymbia aparrerinja — taxon concept and sourced evidence.
# Identity is the URN. GitHub repo / release is a locator (dcat).

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dwc:    <http://rs.tdwg.org/dwc/terms/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix ro:     <http://purl.obolibrary.org/obo/RO_> .
@prefix envo:   <http://purl.obolibrary.org/obo/ENVO_> .
@prefix to:     <http://purl.obolibrary.org/obo/TO_> .
@prefix tk:     <https://localcontexts.org/ontology/tk-bc.ttl#> .
@prefix aunsl:  <https://biodiversity.org.au/voc/taxa/> .
@prefix qualia: <urn:qualia:taxon:> .
@prefix src:    <urn:qualia:source:> .
@prefix claim:  <urn:qualia:claim:corymbia-aparrerinja:> .

qualia:corymbia_aparrerinja a dwc:Taxon , rdfs:Class , dcat:Dataset ;
    rdfs:label "Ghost Gum"@en ;
    dwc:scientificName "Corymbia aparrerinja K.D.Hill & L.A.S.Johnson" ;
    dwc:genus "Corymbia" ;
    dwc:family "Myrtaceae" ;
    dwc:taxonRank "species" ;
    dwc:vernacularName "Ghost Gum"@en , "Aparrerinja"@aer , "Aparre"@aer ;
    dwc:taxonID "GBIF:3180424" ;
    aunsl:lsid <https://id.biodiversity.org.au/taxon/apni/51289371> ;
    dct:identifier <urn:qualia:taxon:corymbia_aparrerinja> ;
    dcat:landingPage <https://github.com/intenteco/corymbia-aparrerinja> ;
    tk:custodial_country "Arrernte Country (Mparntwe / Alice Springs region)" ;
    rdfs:seeAlso <https://bie.ala.org.au/species/https%3A/id.biodiversity.org.au/taxon/apni/51289371> ,
                 <https://www.gbif.org/species/3180424> .

src:ala-taxon a dct:BibliographicResource ;
    dct:identifier <https://bie.ala.org.au/species/https%3A/id.biodiversity.org.au/taxon/apni/51289371> ;
    rdfs:label "ALA taxon page for Corymbia aparrerinja" .

src:sa-botanic a dct:BibliographicResource ;
    dct:identifier <https://plantselector.botanicgardens.sa.gov.au/Plants/Details/18003> ;
    rdfs:label "SA Botanic Gardens plant selector — Corymbia aparrerinja" .

src:nt-landscaping a dct:BibliographicResource ;
    dct:identifier <https://nt.gov.au/__data/assets/pdf_file/0004/1564825/species-guide-for-landscaping-nt.pdf> ;
    rdfs:label "NT species guide for landscaping" .

src:qld-1-3-6 a dct:BibliographicResource ;
    dct:identifier <https://apps.des.qld.gov.au/regional-ecosystems/details/?re=1.3.6> ;
    rdfs:label "Queensland regional ecosystem 1.3.6" .

src:qld-4-7-7 a dct:BibliographicResource ;
    dct:identifier <https://apps.des.qld.gov.au/regional-ecosystems/details/?re=4.7.7> ;
    rdfs:label "Queensland regional ecosystem 4.7.7" .

src:euclid a dct:BibliographicResource ;
    dct:identifier <https://apps.lucidcentral.org/euclid/text/entities/corymbia_aparrerinja.htm> ;
    rdfs:label "EUCLID Corymbia aparrerinja" .

claim:apni-taxon-identity a rdf:Statement ;
    rdf:subject qualia:corymbia_aparrerinja ;
    rdf:predicate dwc:scientificNameID ;
    rdf:object <https://id.biodiversity.org.au/taxon/apni/51289371> ;
    prov:wasDerivedFrom src:ala-taxon ;
    rdfs:comment "ALA maps this accepted species concept to APNI taxon 51289371 (K.D.Hill & L.A.S.Johnson)."@en .

qualia:corymbia_aparrerinja dwc:family "Myrtaceae" ;
    dwc:scientificNameID <https://id.biodiversity.org.au/taxon/apni/51289371> ;
    prov:wasDerivedFrom src:ala-taxon .

qualia:corymbia_terminalis a dwc:Taxon ;
    dwc:scientificName "Corymbia terminalis" ;
    rdfs:label "Desert Bloodwood"@en .

qualia:corymbia_aparrerinja ro:0002081 qualia:corymbia_terminalis ;
    prov:wasDerivedFrom src:qld-1-3-6 ;
    rdfs:comment "Co-occurs with Corymbia terminalis in mapped woodland; this does not establish facilitation."@en .

qualia:corymbia_aparrerinja
    rdfs:comment "Occurs in ghost gum and bloodwood woodland on sandy levees (Qld RE 1.3.6) and in low open woodland on rocky breakaways (Qld RE 4.7.7)."@en ;
    prov:wasDerivedFrom src:qld-1-3-6 , src:qld-4-7-7 .

qualia:corymbia_aparrerinja
    rdfs:comment "Horticultural guidance lists full sun, sand or loam, and sandy to rocky well-drained soil. Not a measured niche limit."@en ;
    prov:wasDerivedFrom src:sa-botanic , src:nt-landscaping .
