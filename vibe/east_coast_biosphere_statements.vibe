pure fn dwc_rank(gbif_rank: string) -> string {
    if gbif_rank == "SPECIES" { return "species"; }
    if gbif_rank == "GENUS" { return "genus"; }
    if gbif_rank == "FAMILY" { return "family"; }
    if gbif_rank == "ORDER" { return "order"; }
    return "";
}

pure fn stmt(s: string, p: string, o: string) -> Record {
    return {s: s, p: p, o: o,
        quin: quin.statement(subject: s, predicate: p, object: o, context: 0)};
}

pure fn dwc_statements_for(render_key: string, asset_iri: string) -> List {
    let t = taxon_for(render_key);
    if t.bound == 0.0 {
        return [];
    }
    let taxon = t.iri;
    let mut statements = [
        stmt(taxon, "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
            "http://rs.tdwg.org/dwc/terms/Taxon"),
        stmt(taxon, "http://rs.tdwg.org/dwc/terms/taxonID", taxon),
        stmt(taxon, "http://rs.tdwg.org/dwc/terms/scientificName", t.scientificName),
        stmt(taxon, "http://rs.tdwg.org/dwc/terms/taxonRank", dwc_rank(t.rank)),
        stmt(taxon, "http://rs.tdwg.org/dwc/terms/vernacularName", t.commonName)
    ];
    if asset_iri != "" {
        statements = statements.push(stmt(asset_iri,
            "http://xmlns.com/foaf/0.1/depicts", taxon));
        if t.maturityIri != "" {
            statements = statements.push(stmt(asset_iri,
                "qualia:accrual:maturityClass", t.maturityIri));
        }
        if t.irreversibilityIri != "" {
            statements = statements.push(stmt(asset_iri,
                "qualia:accrual:irreversibilityClass", t.irreversibilityIri));
        }
    }
    return statements;
}

