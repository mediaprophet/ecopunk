    fauna:n3_rule_summary "PREFER forest_edge_radius_m < 60.0; WHEN ambient_lux < 1500 PERMIT grazing(poa_sieberiana); IF threat_detected OBLIGATE retreat_to(sclerophyll_understory)." ;
    sosa:call_name "Soft rasping hiss & paired foot thump" ;
    sosa:call_fundamental_hz "210.0"^^xsd:decimal ;
    sosa:wave_pattern "low_thump" ;
    tk:custodial_country "Ngarigo, Walgalu, and D'harawal Country" ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    ro:trophically_interacts_with qualia:poa_sieberiana, qualia:lomandra_longifolia, qualia:themeda_triandra .

