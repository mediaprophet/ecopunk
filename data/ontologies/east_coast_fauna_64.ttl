@prefix pato: <http://purl.obolibrary.org/obo/pato.owl#> .
@prefix aunsl: <https://biodiversity.org.au/voc/taxa/> .
@prefix ncbitaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix gbif: <https://www.gbif.org/species/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix tk: <https://localcontexts.org/ontology/tk-bc.ttl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix qualia: <urn:qualia:taxon:> .
@prefix fauna: <urn:qualia:ontology:fauna#> .

# 1. Macropus giganteus (Eastern Grey Kangaroo)
qualia:macropus_giganteus a dwc:Taxon , rdfs:Class ;
    rdfs:label "Eastern Grey Kangaroo"@en ;
    dwc:scientificName "Macropus giganteus" ;
    dwc:vernacularName "Eastern Grey Kangaroo"@en , "Buru / Wambool" ;
    dwc:class "Mammalia" ;
    dwc:order "Diprotodontia" ;
    dwc:family "Macropodidae" ;
    dwc:genus "Macropus" ;
    dwc:taxonRank "species" ;
    aunsl:lsid "https://biodiversity.org.au/afd/taxa/4512" ;
    fauna:gbif_id "2440132" ;
    fauna:ncbi_id "9315" ;
    fauna:iucn_status "LC" ;
    envo:habitat_stratum "terrestrial" ;
    envo:elevation_min "0"^^xsd:integer ;
    envo:elevation_max "1800"^^xsd:integer ;
    fauna:occurs_in_sector "talbingo_pines", "jounama_karst", "three_mile_dam", "sydney_sandstone", "noosa_headland" ;
    fauna:adult_mass_kg "55.0"^^xsd:decimal ;
    fauna:body_length_m "1.5"^^xsd:decimal ;
    fauna:bmr_watts "68.0"^^xsd:decimal ;
    fauna:body_temp_c "36.2"^^xsd:decimal ;
    fauna:thermoregulation "endotherm" ;
    fauna:locomotion_class "bipedal_hop" ;
    fauna:velocity_walk_ms "1.4"^^xsd:decimal ;
    fauna:velocity_sprint_ms "17.8"^^xsd:decimal ;
    uberon:archetype_3d "macropod" ;
    uberon:skeletal_joints "24"^^xsd:integer ;
    ecocore:activity_cycle "crepuscular" ;
    ecocore:diet_guild "grazer" ;
    fauna:n3_rule_summary "WHEN solar_elevation_deg < 25 OR sky_cloud_cover > 0.6 PERMIT foraging_in(poa_sieberiana_meadow); IF predator_dist_m < 48.0 OBLIGATE emit_alarm_thump AND transition(FLEEING)." ;
    sosa:call_name "Guttural alarm cough & hind-foot ground thump" ;
    sosa:call_fundamental_hz "160.0"^^xsd:decimal ;
    sosa:wave_pattern "low_thump" ;
    tk:custodial_country "Ngarigo, Walgalu, Wiradjuri, and Yuin Country" ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    ro:trophically_interacts_with qualia:poa_sieberiana, qualia:themeda_triandra, qualia:microlaena_stipoides .

# 2. Notamacropus rufogriseus (Red-necked Wallaby)
