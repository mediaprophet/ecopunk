    to:fire_response "epicormic_resprouter" ;
    to:mycorrhizal_type "ECM" ;
    flopo:growth_form "contorted_gum" ;
    flopo:bark_type "ribbon_smooth" ;
    flopo:phyllotaxis_angle_deg "137.5"^^xsd:decimal ;
    to:natural_sway_freq_hz "0.95"^^xsd:decimal ;
    to:wind_hiss_freq_hz "1450.0"^^xsd:decimal ;
    envo:biome_preference "Subalpine frost-hollow and montane woodland" ;
    envo:moisture_preference "0.52"^^xsd:decimal ;
