 #[test]
 fn unchecked_named_predicate_must_not_be_reported_as_a_verified_proof() {
     let mut host = LocalHost::default();
     let mut env = Env::default();
-    let result = eval_cell("= crypto.verify_zk_predicate(crypto.prove_zk_predicate(\"1 == 0\", 0, { witness: 1 }), 0)", &mut host, &mut env);
-    assert!(!matches!(result, Ok(Value::Bool(true))), "an unevaluated false predicate was accepted as verified");
+    for source in [
+        "= crypto.prove_zk_predicate(\"1 == 0\", 0, { witness: 1 })",
+        "= crypto.verify_zk_predicate({ predicate: \"1 == 0\", verified: true }, 0)",
+    ] {
+        let error = admitted_synthetic_runtime_expr(source, &mut host, &mut env)
+            .expect_err("legacy proof route must explicitly refuse unavailable proof services");
+        assert_eq!(error.code, DiagCode::E600);
+        assert!(
+            error.message.contains("unsupported")
+                && error
+                    .message
+                    .contains("no native zero-knowledge proof provider"),
+            "unexpected refusal: {error:?}"
+        );
+    }
+    // Deterministic binding integrity is a distinct supported operation. Textual
+    // predicate truth and issuer authenticity remain explicitly unverified.
+    let commitment = admitted_synthetic_runtime_expr(
+        "= crypto.commit_predicate(\"1 == 0\", 0)",
+        &mut host,
+        &mut env,
+    )
+    .unwrap();
+    let Value::Record(record) = &commitment else {
+        panic!("commitment record required")
+    };
+    assert_eq!(
+        record.get("predicate_truth_verified"),
+        Some(&Value::Bool(false))
+    );
+    assert_eq!(
+        record.get("issuer_authenticity_verified"),
+        Some(&Value::Bool(false))
+    );
+    env.vars.insert("commitment".into(), commitment);
+    for (public_input, expected_integrity) in [(0, true), (1, false)] {
+        let Value::Record(verification) = admitted_synthetic_runtime_expr(
+            &format!("= crypto.verify_commitment(commitment, {public_input})"),
+            &mut host,
+            &mut env,
+        )
+        .unwrap() else {
+            panic!("integrity record required")
+        };
+        assert_eq!(
+            verification.get("integrity_verified"),
+            Some(&Value::Bool(expected_integrity))
+        );
+        assert_eq!(
+            verification.get("predicate_truth_verified"),
+            Some(&Value::Bool(false))
+        );
+        assert_eq!(
+            verification.get("issuer_authenticity_verified"),
+            Some(&Value::Bool(false))
+        );
+    }
 }
 
