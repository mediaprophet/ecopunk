# Codes are exactly the current Core enum representations, not invented life
# stages or proof of observed age/sex. The native family codec remains owner.
eco:coreLifecycleStageCode rdf:type rdf:Property ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:corePhenotypeCode rdf:type rdf:Property ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:coreLodCode rdf:type rdf:Property ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:coreStructuralStateCode rdf:type rdf:Property ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:coreFamilySchemaSource rdf:type rdf:Property ; rdfs:range prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:coreLifecycleSchemaSource rdf:type rdf:Property ; rdfs:range prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:namespaceMethod rdf:type rdf:Property ; rdfs:isDefinedBy eco:Ontology .
eco:SourceDomainFallback rdf:type eco:ReviewStatus .
eco:snapshotKind rdf:type rdf:Property ; rdfs:isDefinedBy eco:Ontology .
eco:OwnedGraphExcludedBaseHmcSnapshot rdf:type eco:ReviewStatus .

# Authored skin controls, not measured anatomical attachment/acceptance claims.
# Raw source weights remain exact f32 values. The existing geometry owner
# normalizes linear section interpolation, coalesces duplicate joints and
# writes at most four canonical slots. No per-vertex measurement is asserted.
eco:AuthoredSkinStation rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredSkinInfluence rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:SkinInterpolationPolicy rdf:type rdfs:Class ; rdfs:isDefinedBy eco:Ontology .
eco:NormalizedLinearSectionFourSlotSkin rdf:type eco:SkinInterpolationPolicy .
eco:skinInterpolationPolicy rdf:type rdf:Property ; rdfs:domain eco:AuthoredPart ; rdfs:range eco:SkinInterpolationPolicy ; rdfs:isDefinedBy eco:Ontology .
eco:hasSkinStation rdf:type rdf:Property ; rdfs:domain eco:AuthoredPart ; rdfs:range eco:AuthoredSkinStation ; rdfs:isDefinedBy eco:Ontology .
eco:hasMirrorSkinStation rdf:type rdf:Property ; rdfs:domain eco:AuthoredPart ; rdfs:range eco:AuthoredSkinStation ; rdfs:isDefinedBy eco:Ontology .
eco:hasSkinInfluence rdf:type rdf:Property ; rdfs:domain eco:AuthoredSkinStation ; rdfs:range eco:AuthoredSkinInfluence ; rdfs:isDefinedBy eco:Ontology .
eco:sectionIndex rdf:type rdf:Property ; rdfs:domain eco:AuthoredSkinStation ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:influenceSlot rdf:type rdf:Property ; rdfs:domain eco:AuthoredSkinInfluence ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:sourceSkinWeight rdf:type rdf:Property ; rdfs:domain eco:AuthoredSkinInfluence ; rdfs:range xsd:float ; rdfs:isDefinedBy eco:Ontology .

# Authored generator recipe controls. These records state how serial source
# sections are grouped and sampled; they do not assert anatomical continuity.
eco:AuthoredSerialLoftChainRecipe rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredLoftChainMember rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredSerialRecipeNotBiologicalProof rdf:type eco:ReviewStatus .
eco:hasLoftChainRecipe rdf:type rdf:Property ; rdfs:domain eco:AuthoredModelDefinition ; rdfs:range eco:AuthoredSerialLoftChainRecipe ; rdfs:isDefinedBy eco:Ontology .
eco:hasOrderedChainMember rdf:type rdf:Property ; rdfs:domain eco:AuthoredSerialLoftChainRecipe ; rdfs:range eco:AuthoredLoftChainMember ; rdfs:isDefinedBy eco:Ontology .
eco:memberLoftPart rdf:type rdf:Property ; rdfs:domain eco:AuthoredLoftChainMember ; rdfs:range eco:LoftPart ; rdfs:isDefinedBy eco:Ontology .
eco:recipeStatus rdf:type rdf:Property ; rdfs:domain eco:AuthoredSerialLoftChainRecipe ; rdfs:range eco:ReviewStatus ; rdfs:isDefinedBy eco:Ontology .
eco:memberOrdinal rdf:type rdf:Property ; rdfs:domain eco:AuthoredLoftChainMember ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:firstSourceSectionInclusive rdf:type rdf:Property ; rdfs:domain eco:AuthoredLoftChainMember ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:lastSourceSectionInclusive rdf:type rdf:Property ; rdfs:domain eco:AuthoredLoftChainMember ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:radialSegments rdf:type rdf:Property ; rdfs:domain eco:AuthoredSerialLoftChainRecipe ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .
eco:subdivisions rdf:type rdf:Property ; rdfs:domain eco:AuthoredSerialLoftChainRecipe ; rdfs:range xsd:integer ; rdfs:isDefinedBy eco:Ontology .

# Authored arithmetic portability provenance. These facts identify a declared
# generator method policy, not a cross-target output-equality receipt.
eco:AuthoredNumericExecutionProfile rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:NumericMethodPolicy rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:declaresNumericExecutionProfile rdf:type rdf:Property ; rdfs:domain eco:AuthoredModelDefinition ; rdfs:range eco:AuthoredNumericExecutionProfile ; rdfs:isDefinedBy eco:Ontology .
eco:usesNumericMethodPolicy rdf:type rdf:Property ; rdfs:domain eco:AuthoredNumericExecutionProfile ; rdfs:range eco:NumericMethodPolicy ; rdfs:isDefinedBy eco:Ontology .
eco:implementedBySoftware rdf:type rdf:Property ; rdfs:domain eco:NumericMethodPolicy ; rdfs:range prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:NumericFunctionScope rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:numericMethodScope rdf:type rdf:Property ; rdfs:domain eco:NumericMethodPolicy ; rdfs:range eco:NumericFunctionScope ; rdfs:isDefinedBy eco:Ontology .
eco:numericProfileStatus rdf:type rdf:Property ; rdfs:domain eco:AuthoredNumericExecutionProfile ; rdfs:range eco:ReviewStatus ; rdfs:isDefinedBy eco:Ontology .
eco:PortableSoftwareV1 rdf:type eco:AuthoredNumericExecutionProfile .
eco:LibmBoundedAnatomySinCosPowV1 rdf:type eco:NumericMethodPolicy .
eco:LibmBoundedAnatomySinCosPowV1 eco:implementedBySoftware <https://crates.io/crates/libm/0.2.16> ; eco:numericMethodScope eco:BoundedAnatomySinCosPow .
eco:PortableSoftwareV1 eco:usesNumericMethodPolicy eco:LibmBoundedAnatomySinCosPowV1 ; eco:numericProfileStatus eco:SourceDeclaredMethodNotExecutionProof .
eco:BoundedAnatomySinCosPow rdf:type eco:NumericFunctionScope .
eco:SourceDeclaredMethodNotExecutionProof rdf:type eco:ReviewStatus .

# Optional authored groom controls. All values remain source recipe facts; the
# geometry owner may later execute them, but the projection itself is not a
# groom receipt or biological observation. Binary64 parameters use the shared
# native full-precision Q42 literal owner and are declared as xsd:double.
eco:AuthoredGroomRecipe rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredGroomRegion rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredGroomMaterialBinding rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredGroomSurfaceMaterial rdf:type rdfs:Class ; rdfs:subClassOf eco:AuthoredGroomMaterialBinding ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredGroomRegionSurfaceMaterial rdf:type rdfs:Class ; rdfs:subClassOf eco:AuthoredGroomMaterialBinding ; rdfs:isDefinedBy eco:Ontology .
eco:SourceDeclaredGroomControlsNotExecutionProof rdf:type eco:ReviewStatus .
eco:AuthoredGeometryMethod rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:GroomSamplingRule rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:GroomCurveRule rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:hasGroomRecipe rdf:type rdf:Property ; rdfs:domain eco:AuthoredModelDefinition ; rdfs:range eco:AuthoredGroomRecipe ; rdfs:isDefinedBy eco:Ontology .
eco:groomRecipeStatus rdf:type rdf:Property ; rdfs:domain eco:AuthoredGroomRecipe ; rdfs:range eco:ReviewStatus ; rdfs:isDefinedBy eco:Ontology .
eco:geometryMethod rdf:type rdf:Property ; rdfs:domain eco:AuthoredGroomRecipe ; rdfs:range eco:AuthoredGeometryMethod ; rdfs:isDefinedBy eco:Ontology .
eco:geometryOwner rdf:type rdf:Property ; rdfs:range prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AreaPointRegionRejectionNativeBezierFibresV1 rdf:type eco:AuthoredGeometryMethod .
# Historical method identifier retained for prior source/Q42 records. New
# recipes use point-region rejection and must not be labelled with this term.
eco:AreaStratifiedNativeBezierFibresV1 rdf:type eco:AuthoredGeometryMethod .
eco:AreaWeightedPointRegionRejectionBarycentricRoots rdf:type eco:GroomSamplingRule .
