@prefix eco: <urn:ecopunk:species-review-knowledge:v1#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
# Technical source-review ontology; no measured biology or rights grant.
eco:Ontology rdf:type owl:Ontology .
eco:SpeciesStudy rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AssetResource rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredClip rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:CoverageClaim rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:ReviewStatus rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:SourceNamespaceDeclaration rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:claimStatus rdf:type rdf:Property ; rdfs:domain prov:Entity ; rdfs:range eco:ReviewStatus ; rdfs:isDefinedBy eco:Ontology .
eco:hasResource rdf:type rdf:Property ; rdfs:domain eco:SpeciesStudy ; rdfs:range eco:AssetResource ; rdfs:isDefinedBy eco:Ontology .
eco:hasClip rdf:type rdf:Property ; rdfs:domain eco:AssetResource ; rdfs:range eco:AuthoredClip ; rdfs:isDefinedBy eco:Ontology .
eco:hasCoverageClaim rdf:type rdf:Property ; rdfs:domain eco:SpeciesStudy ; rdfs:range eco:CoverageClaim ; rdfs:isDefinedBy eco:Ontology .
eco:coverageStatus rdf:type rdf:Property ; rdfs:domain eco:CoverageClaim ; rdfs:range eco:ReviewStatus ; rdfs:isDefinedBy eco:Ontology .
eco:sourceNamespace rdf:type rdf:Property ; rdfs:domain eco:SourceNamespaceDeclaration ; rdfs:range rdfs:Resource ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredStudyUnaccepted rdf:type eco:ReviewStatus .
eco:DeclaredUnaccepted rdf:type eco:ReviewStatus .
eco:MissingOrUnassessed rdf:type eco:ReviewStatus .
eco:ReferenceOnly rdf:type eco:ReviewStatus .
eco:RdfSource rdf:type dct:FileFormat .
eco:JsonCompatibilitySource rdf:type dct:FileFormat .
eco:CsvSource rdf:type dct:FileFormat .
eco:OtherDeclaredSource rdf:type dct:FileFormat .
eco:HtmlSource rdf:type dct:FileFormat .

# Authored model semantics: these describe the synthetic definition, never an
# observed specimen or an automatically adopted external assertion.
eco:AuthoredModelDefinition rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:EditableModelRepresentation rdf:type rdfs:Class ; rdfs:subClassOf eco:AssetResource ; rdfs:isDefinedBy eco:Ontology .
eco:RequiredRepresentation rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:AuthoredPart rdf:type rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:isDefinedBy eco:Ontology .
eco:LoftPart rdf:type rdfs:Class ; rdfs:subClassOf eco:AuthoredPart ; rdfs:isDefinedBy eco:Ontology .
eco:EllipsoidPart rdf:type rdfs:Class ; rdfs:subClassOf eco:AuthoredPart ; rdfs:isDefinedBy eco:Ontology .
eco:EarPart rdf:type rdfs:Class ; rdfs:subClassOf eco:AuthoredPart ; rdfs:isDefinedBy eco:Ontology .
